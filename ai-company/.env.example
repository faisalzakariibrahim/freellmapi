# Where your FreeLLMAPI router is running (the /v1 base URL).
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Unified API key from the FreeLLMAPI dashboard (Keys page header).
# Stays on the server; it is never sent to the browser.
FREELLMAPI_API_KEY=freellmapi-your-unified-key

# Optional: password-protect the dashboard (HTTP Basic auth, any username).
# Strongly recommended if you open it beyond localhost.
COMPANY_PASSWORD=

# Optional: per-worker request timeout in milliseconds (default 120000).
LLM_TIMEOUT_MS=120000
